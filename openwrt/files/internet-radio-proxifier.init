#!/bin/sh /etc/rc.common
# procd service for internet-radio-proxifier. Settings: /etc/config/internet-radio-proxifier

START=95
STOP=10
USE_PROCD=1
NAME=internet-radio-proxifier
PROG=/usr/bin/$NAME
EXAMPLE=/usr/share/$NAME/settings.example.ini

# First start (or a missing file): create the settings file from the
# example, owned by the service user, who must be able to rewrite it from
# the settings page.
prepare_settings() {
	local file="$1" dir="${1%/*}"
	[ -f "$file" ] && return 0
	[ -f "$EXAMPLE" ] || return 1
	mkdir -p "$dir" && cp "$EXAMPLE" "$file" || return 1
	chown nobody:nogroup "$dir" "$file" 2>/dev/null || chown 65534:65534 "$dir" "$file"
	chmod 700 "$dir"
	chmod 600 "$file"
	logger -t $NAME "created $file from $EXAMPLE"
}

start_service() {
	local enabled address port config
	config_load $NAME
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get address main address '::'
	config_get port main port '9876'
	config_get config main config "/etc/$NAME/settings.ini"

	if ! prepare_settings "$config"; then
		logger -t $NAME "settings file $config not found"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" --address "$address" --port "$port" --config "$config"
	# Unprivileged; it only needs to write the settings file's directory.
	procd_set_param user nobody
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger $NAME
}
