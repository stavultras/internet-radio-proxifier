config internet-radio-proxifier 'main'
	option enabled '1'
	# Address to listen on: '::' = all interfaces (IPv6 and IPv4),
	# '0.0.0.0' = all IPv4 interfaces, or one address such as '192.168.1.1'
	option address '::'
	option port '9876'
	# Proxy and station list (edited from the Settings page) and the
	# Settings page password (password = ..., edit the file by hand)
	option config '/etc/internet-radio-proxifier/settings.ini'
